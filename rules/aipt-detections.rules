)


# ============================================================================
# 4. 일반 HTTP 자동화/탐색 패턴 (4개)
# ============================================================================
# [9500006] 웹 애플리케이션 Manifest 탐색
# 탐지 조건: GET 요청 URI에 manifest.json 계열 경로가 있고 Referer 및 Sec-Fetch-Dest 헤더가 없음
# 탐지 의미: 브라우저 탐색 흐름과 다른 정찰성 manifest 조회 정황
# 오탐/한계: 정상 빌드 도구·API 클라이언트·헤더 생략 브라우저 요청도 해당
# 원본 정책: informational (원본 정책 등급이지 Snort drop 동작이 아님)
# 빈도 제한: 동일 요청 출발지에서 60초 동안 2회: event_filter 필요
# 원본 SID: 9500006 | 센서 위치: 웹 서버 측 HTTP 트래픽
alert http any any -> $HOME_NET any (
    msg:"AIPT Generic Web App Manifest Probe Without Referer";
    flow:established,to_server;
    http_method;
    content:"GET";
    http_uri;
    pcre:"/\/(?:asset-manifest\.json|\.vite\/manifest\.json|manifest\.json)(?:\?|$)/";
    http_header_test:field referer,absent;
    http_raw_header;
    pcre:!"/^sec-fetch-dest[ \t]*:/im";
    classtype:attempted-recon;
    sid:9500006;
    rev:4;
    metadata:affected_product Any, attack_target Web_Server, confidence Low, created_at 2026_10_09, deployment Perimeter, performance_impact Low, signature_severity Informational, tag ai_pentest, updated_at 2026_10_12;
)

# [9500007] Headless Chromium User-Agent
# 탐지 조건: User-Agent에 HeadlessChrome/이 포함된 요청
# 탐지 의미: 헤드리스 브라우저 자동화 클라이언트 식별
# 오탐/한계: Lighthouse·QA·모니터링 등 정상 헤드리스 브라우저도 탐지
# 원본 정책: informational (원본 정책 등급이지 Snort drop 동작이 아님)
# 빈도 제한: 출발지별 300초에 경보 1회 제한: event_filter 필요
# 원본 SID: 9500007 | 센서 위치: 웹 서버 측 HTTP 트래픽
alert http any any -> $HOME_NET any (
    msg:"AIPT Generic Headless Chromium User-Agent (browser automation)";
    flow:established,to_server;
    http_header:field user-agent;
    content:"HeadlessChrome/",fast_pattern;
    classtype:attempted-recon;
    sid:9500007;
    rev:4;
    metadata:affected_product Any, attack_target Web_Server, confidence Low, created_at 2026_10_09, deployment Perimeter, performance_impact Low, signature_severity Informational, tag ai_pentest, updated_at 2026_10_12;
)

# [9500008] 404 응답 집중 발생
# 탐지 조건: 웹 서버에서 클라이언트로 전달하는 HTTP 응답의 상태 코드가 404
# 탐지 의미: 404 빈도 증가를 URI 열거·스캔의 간접 지표로 사용
# 오탐/한계: 링크 손상·크롤러·정상 애플리케이션 오류도 404 증가 유발
# 원본 정책: alert (원본 정책 등급이지 Snort drop 동작이 아님)
# 빈도 제한: 응답 목적지 IP별 60초 동안 30회: event_filter 필요; 없으면 개별 404에 탐지
# 원본 SID: 9500008 | 센서 위치: 웹 서버 측 HTTP 트래픽
alert http $HOME_NET any -> any any (
    msg:"AIPT Generic HTTP 404 Burst to Single Client (path enumeration)";
    flow:established,to_client;
    http_stat_code;
    content:"404";
    classtype:attempted-recon;
    sid:9500008;
    rev:4;
    metadata:affected_product Any, attack_target Web_Server, confidence Medium, created_at 2026_10_09, deployment Perimeter, performance_impact Low, signature_severity Minor, tag ai_pentest, updated_at 2026_10_12;
)

# [9500010] Go HTTP Client 기본 UA
# 탐지 조건: GET 요청의 User-Agent가 Go-http-client/로 시작
# 탐지 의미: Go 표준 HTTP 클라이언트가 보내는 기본 UA 탐지
# 오탐/한계: 정상 Go 기반 모니터링·마이크로서비스·백엔드 클라이언트도 탐지
# 원본 정책: informational (원본 정책 등급이지 Snort drop 동작이 아님)
# 빈도 제한: 출발지별 600초에 경보 1회 제한: event_filter 필요
# 원본 SID: 9500010 | 센서 위치: 웹 서버 측 HTTP 트래픽
alert http any any -> $HOME_NET any (
    msg:"AIPT Generic Go-http-client Default User-Agent (Go agent tooling)";
    flow:established,to_server;
    http_method;
    content:"GET";
    http_header:field user-agent;
    content:"Go-http-client/",fast_pattern,offset 0,depth 15;
    classtype:misc-activity;
    sid:9500010;
    rev:4;
    metadata:affected_product Any, attack_target Web_Server, confidence Low, created_at 2026_10_09, deployment Perimeter, performance_impact Low, signature_severity Informational, tag ai_pentest, updated_at 2026_10_12;
)


