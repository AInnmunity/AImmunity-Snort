# 원본 SID: 9500004 | 센서 위치: 웹 서버 측 HTTP 트래픽
alert http any any -> $HOME_NET any (
    msg:"AIPT ARTEX api-recon Skill Script User-Agent (spa-api-recon)";
    flow:established,to_server;
    http_header:field user-agent;
    content:"Mozilla/5.0 (spa-api-recon",fast_pattern,offset 0,depth 26;
    reference:url,github.com/Autumn-27/ARTEX;
    classtype:attempted-recon;
    sid:9500004;
    rev:4;
    metadata:affected_product ARTEX, attack_target Web_Server, confidence High, created_at 2026_10_09, deployment Perimeter, performance_impact Low, signature_severity Major, tag ai_pentest, updated_at 2026_10_12;
)


